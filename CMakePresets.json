{
  "version": 6,
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Ninja", "binaryDir": "build/${presetName}", "cacheVariables": {"SWARM_PYTHON": "OFF"}},
    {"name": "release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "relwithdebinfo", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
    {"name": "debug", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined"}}
  ],
  "buildPresets": [{"name": "release", "configurePreset": "release"}, {"name": "relwithdebinfo", "configurePreset": "relwithdebinfo"}, {"name": "debug", "configurePreset": "debug"}],
  "testPresets": [{"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}, {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}}]
}
